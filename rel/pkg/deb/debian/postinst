#!/bin/sh
# postinst script for riak-cs-control
#
# see: dh_installdeb(1)

set -e

user=riak-control
if ! getent group $user >/dev/null; then
    addgroup --system $user
fi

if ! getent passwd $user >/dev/null; then
    adduser --ingroup $user \
            --home /var/lib/riak-control \
            --disabled-password \
            --system --shell /bin/bash --no-create-home \
            --gecos "Riak Control" $user
fi

for i in lib log; do
    chown -R $user:$user /var/$i/riak
done
chown -R $user:$user /etc/riak-control

case "$1" in
    configure)
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0

#!/usr/bin/make -f
# -*- makefile -*-

# Uncomment this to turn on verbose mode.
export DH_VERBOSE=1

ROOTDIR := debian/riak-control

build:
	sed -i 's|.rctl_pkg_docroot|/usr/share/riak-control|' bin/riak-control
	sed -i 's|.rctl_pkg_etcdir|/etc/riak-control|' bin/riak-control
	sed -i 's|.rctl_pkg_datadir|/var/lib/riak-control|' bin/riak-control
	sed -i 's|.rctl_pkg_logdir|/var/log/riak-control|' bin/riak-control

clean:

install:
	dh_testdir
	dh_testroot
	dh_prep
	dh_installdirs
	dh_install
	dh_installman
	dh_fixperms

# We have nothing to do by default.
binary-indep: install build-stamp
	dh_compress -a
	dh_installdeb
	dh_gencontrol
	dh_builddeb

build-stamp:

binary: binary-indep
